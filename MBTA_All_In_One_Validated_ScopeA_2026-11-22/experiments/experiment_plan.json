{
  "created_date": "2026-11-19",
  "primary_population": "same 41 scheduled incoming trips on 2026-10-15; no new data collection or delay scenarios",
  "objective": "equal-weight mean waiting after transfer allowance; full-day onward service retained",
  "parameters_are": "declared study assumptions, not measured operating requirements",
  "primary_heuristic": {
    "name": "single_chronological_pass",
    "definition": "Start from zero shifts. Visit the six original departure times in chronological order once. For the current trip, evaluate every permitted grid shift while holding the other five at their present values. Reject any full-timetable constraint violation. Adopt a change only if it strictly lowers total waiting. Among equal-cost improving changes, choose smallest absolute shift, then earlier departure. Do not revisit earlier trips.",
    "starting_point_must_be_feasible": true,
    "no_optimum_information_used": true
  },
  "supplementary_heuristic": "Repeat chronological passes until a full pass has no strictly improving feasible coordinate move; report separately, never replace primary benchmark with best-performing variant.",
  "comparison_rules": [
    "Rebuild shift domains and vehicle/headway RHS for every parameter case.",
    "Evaluate status quo, newly reoptimized schedule, and unchanged nominal optimum separately.",
    "Do not quote percentage improvement against an infeasible baseline.",
    "Infeasible domains and infeasible MILPs remain explicitly infeasible, not missing observations.",
    "Retain source files and old results unchanged; write new runs separately.",
    "All non-stranded costs are independently evaluated using earliest eligible departure.",
    "Exact enumeration is used when grid product <= 2000000; otherwise solver optimum is checked by independent timetable evaluation.",
    "Solver tolerances are reported; a time limit does not count as proven optimal.",
    "Ablations are diagnostic relaxed models, not deployment recommendations.",
    "No parameter values are tuned after viewing new heuristic outcomes."
  ],
